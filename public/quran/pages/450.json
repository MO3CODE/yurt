{"page":450,"juz":23,"ayas":[{"s":37,"a":103,"t":"فَلَمَّآ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ ١٠٣"},{"s":37,"a":104,"t":"وَنَٰدَيۡنَٰهُ أَن يَٰٓإِبۡرَٰهِيمُ ١٠٤"},{"s":37,"a":105,"t":"قَدۡ صَدَّقۡتَ ٱلرُّءۡيَآۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ١٠٥"},{"s":37,"a":106,"t":"إِنَّ هَٰذَا لَهُوَ ٱلۡبَلَٰٓؤُاْ ٱلۡمُبِينُ ١٠٦"},{"s":37,"a":107,"t":"وَفَدَيۡنَٰهُ بِذِبۡحٍ عَظِيمٖ ١٠٧"},{"s":37,"a":108,"t":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ ١٠٨"},{"s":37,"a":109,"t":"سَلَٰمٌ عَلَىٰٓ إِبۡرَٰهِيمَ ١٠٩"},{"s":37,"a":110,"t":"كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ١١٠"},{"s":37,"a":111,"t":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ ١١١"},{"s":37,"a":112,"t":"وَبَشَّرۡنَٰهُ بِإِسۡحَٰقَ نَبِيّٗا مِّنَ ٱلصَّٰلِحِينَ ١١٢"},{"s":37,"a":113,"t":"وَبَٰرَكۡنَا عَلَيۡهِ وَعَلَىٰٓ إِسۡحَٰقَۚ وَمِن ذُرِّيَّتِهِمَا مُحۡسِنٞ وَظَالِمٞ لِّنَفۡسِهِۦ مُبِينٞ ١١٣"},{"s":37,"a":114,"t":"وَلَقَدۡ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ ١١٤"},{"s":37,"a":115,"t":"وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ ١١٥"},{"s":37,"a":116,"t":"وَنَصَرۡنَٰهُمۡ فَكَانُواْ هُمُ ٱلۡغَٰلِبِينَ ١١٦"},{"s":37,"a":117,"t":"وَءَاتَيۡنَٰهُمَا ٱلۡكِتَٰبَ ٱلۡمُسۡتَبِينَ ١١٧"},{"s":37,"a":118,"t":"وَهَدَيۡنَٰهُمَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ ١١٨"},{"s":37,"a":119,"t":"وَتَرَكۡنَا عَلَيۡهِمَا فِي ٱلۡأٓخِرِينَ ١١٩"},{"s":37,"a":120,"t":"سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ ١٢٠"},{"s":37,"a":121,"t":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ١٢١"},{"s":37,"a":122,"t":"إِنَّهُمَا مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ ١٢٢"},{"s":37,"a":123,"t":"وَإِنَّ إِلۡيَاسَ لَمِنَ ٱلۡمُرۡسَلِينَ ١٢٣"},{"s":37,"a":124,"t":"إِذۡ قَالَ لِقَوۡمِهِۦٓ أَلَا تَتَّقُونَ ١٢٤"},{"s":37,"a":125,"t":"أَتَدۡعُونَ بَعۡلٗا وَتَذَرُونَ أَحۡسَنَ ٱلۡخَٰلِقِينَ ١٢٥"},{"s":37,"a":126,"t":"ٱللَّهَ رَبَّكُمۡ وَرَبَّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ ١٢٦"}]}