{"page":449,"juz":23,"ayas":[{"s":37,"a":77,"t":"وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ ٱلۡبَاقِينَ ٧٧"},{"s":37,"a":78,"t":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ ٧٨"},{"s":37,"a":79,"t":"سَلَٰمٌ عَلَىٰ نُوحٖ فِي ٱلۡعَٰلَمِينَ ٧٩"},{"s":37,"a":80,"t":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ٨٠"},{"s":37,"a":81,"t":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ ٨١"},{"s":37,"a":82,"t":"ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ ٨٢"},{"s":37,"a":83,"t":"۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبۡرَٰهِيمَ ٨٣"},{"s":37,"a":84,"t":"إِذۡ جَآءَ رَبَّهُۥ بِقَلۡبٖ سَلِيمٍ ٨٤"},{"s":37,"a":85,"t":"إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَاذَا تَعۡبُدُونَ ٨٥"},{"s":37,"a":86,"t":"أَئِفۡكًا ءَالِهَةٗ دُونَ ٱللَّهِ تُرِيدُونَ ٨٦"},{"s":37,"a":87,"t":"فَمَا ظَنُّكُم بِرَبِّ ٱلۡعَٰلَمِينَ ٨٧"},{"s":37,"a":88,"t":"فَنَظَرَ نَظۡرَةٗ فِي ٱلنُّجُومِ ٨٨"},{"s":37,"a":89,"t":"فَقَالَ إِنِّي سَقِيمٞ ٨٩"},{"s":37,"a":90,"t":"فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ ٩٠"},{"s":37,"a":91,"t":"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمۡ فَقَالَ أَلَا تَأۡكُلُونَ ٩١"},{"s":37,"a":92,"t":"مَا لَكُمۡ لَا تَنطِقُونَ ٩٢"},{"s":37,"a":93,"t":"فَرَاغَ عَلَيۡهِمۡ ضَرۡبَۢا بِٱلۡيَمِينِ ٩٣"},{"s":37,"a":94,"t":"فَأَقۡبَلُوٓاْ إِلَيۡهِ يَزِفُّونَ ٩٤"},{"s":37,"a":95,"t":"قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ ٩٥"},{"s":37,"a":96,"t":"وَٱللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ ٩٦"},{"s":37,"a":97,"t":"قَالُواْ ٱبۡنُواْ لَهُۥ بُنۡيَٰنٗا فَأَلۡقُوهُ فِي ٱلۡجَحِيمِ ٩٧"},{"s":37,"a":98,"t":"فَأَرَادُواْ بِهِۦ كَيۡدٗا فَجَعَلۡنَٰهُمُ ٱلۡأَسۡفَلِينَ ٩٨"},{"s":37,"a":99,"t":"وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهۡدِينِ ٩٩"},{"s":37,"a":100,"t":"رَبِّ هَبۡ لِي مِنَ ٱلصَّٰلِحِينَ ١٠٠"},{"s":37,"a":101,"t":"فَبَشَّرۡنَٰهُ بِغُلَٰمٍ حَلِيمٖ ١٠١"},{"s":37,"a":102,"t":"فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعۡيَ قَالَ يَٰبُنَيَّ إِنِّيٓ أَرَىٰ فِي ٱلۡمَنَامِ أَنِّيٓ أَذۡبَحُكَ فَٱنظُرۡ مَاذَا تَرَىٰۚ قَالَ يَٰٓأَبَتِ ٱفۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ ١٠٢"}]}