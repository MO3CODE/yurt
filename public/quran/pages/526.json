{"page":526,"juz":27,"ayas":[{"s":53,"a":1,"t":"وَٱلنَّجۡمِ إِذَا هَوَىٰ ١"},{"s":53,"a":2,"t":"مَا ضَلَّ صَاحِبُكُمۡ وَمَا غَوَىٰ ٢"},{"s":53,"a":3,"t":"وَمَا يَنطِقُ عَنِ ٱلۡهَوَىٰٓ ٣"},{"s":53,"a":4,"t":"إِنۡ هُوَ إِلَّا وَحۡيٞ يُوحَىٰ ٤"},{"s":53,"a":5,"t":"عَلَّمَهُۥ شَدِيدُ ٱلۡقُوَىٰ ٥"},{"s":53,"a":6,"t":"ذُو مِرَّةٖ فَٱسۡتَوَىٰ ٦"},{"s":53,"a":7,"t":"وَهُوَ بِٱلۡأُفُقِ ٱلۡأَعۡلَىٰ ٧"},{"s":53,"a":8,"t":"ثُمَّ دَنَا فَتَدَلَّىٰ ٨"},{"s":53,"a":9,"t":"فَكَانَ قَابَ قَوۡسَيۡنِ أَوۡ أَدۡنَىٰ ٩"},{"s":53,"a":10,"t":"فَأَوۡحَىٰٓ إِلَىٰ عَبۡدِهِۦ مَآ أَوۡحَىٰ ١٠"},{"s":53,"a":11,"t":"مَا كَذَبَ ٱلۡفُؤَادُ مَا رَأَىٰٓ ١١"},{"s":53,"a":12,"t":"أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ ١٢"},{"s":53,"a":13,"t":"وَلَقَدۡ رَءَاهُ نَزۡلَةً أُخۡرَىٰ ١٣"},{"s":53,"a":14,"t":"عِندَ سِدۡرَةِ ٱلۡمُنتَهَىٰ ١٤"},{"s":53,"a":15,"t":"عِندَهَا جَنَّةُ ٱلۡمَأۡوَىٰٓ ١٥"},{"s":53,"a":16,"t":"إِذۡ يَغۡشَى ٱلسِّدۡرَةَ مَا يَغۡشَىٰ ١٦"},{"s":53,"a":17,"t":"مَا زَاغَ ٱلۡبَصَرُ وَمَا طَغَىٰ ١٧"},{"s":53,"a":18,"t":"لَقَدۡ رَأَىٰ مِنۡ ءَايَٰتِ رَبِّهِ ٱلۡكُبۡرَىٰٓ ١٨"},{"s":53,"a":19,"t":"أَفَرَءَيۡتُمُ ٱللَّٰتَ وَٱلۡعُزَّىٰ ١٩"},{"s":53,"a":20,"t":"وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلۡأُخۡرَىٰٓ ٢٠"},{"s":53,"a":21,"t":"أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلۡأُنثَىٰ ٢١"},{"s":53,"a":22,"t":"تِلۡكَ إِذٗا قِسۡمَةٞ ضِيزَىٰٓ ٢٢"},{"s":53,"a":23,"t":"إِنۡ هِيَ إِلَّآ أَسۡمَآءٞ سَمَّيۡتُمُوهَآ أَنتُمۡ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلۡطَٰنٍۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهۡوَى ٱلۡأَنفُسُۖ وَلَقَدۡ جَآءَهُم مِّن رَّبِّهِمُ ٱلۡهُدَىٰٓ ٢٣"},{"s":53,"a":24,"t":"أَمۡ لِلۡإِنسَٰنِ مَا تَمَنَّىٰ ٢٤"},{"s":53,"a":25,"t":"فَلِلَّهِ ٱلۡأٓخِرَةُ وَٱلۡأُولَىٰ ٢٥"},{"s":53,"a":26,"t":"۞ وَكَم مِّن مَّلَكٖ فِي ٱلسَّمَٰوَٰتِ لَا تُغۡنِي شَفَٰعَتُهُمۡ شَيۡـًٔا إِلَّا مِنۢ بَعۡدِ أَن يَأۡذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرۡضَىٰٓ ٢٦"}]}