{"page":528,"juz":27,"ayas":[{"s":53,"a":45,"t":"وَأَنَّهُۥ خَلَقَ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰ ٤٥"},{"s":53,"a":46,"t":"مِن نُّطۡفَةٍ إِذَا تُمۡنَىٰ ٤٦"},{"s":53,"a":47,"t":"وَأَنَّ عَلَيۡهِ ٱلنَّشۡأَةَ ٱلۡأُخۡرَىٰ ٤٧"},{"s":53,"a":48,"t":"وَأَنَّهُۥ هُوَ أَغۡنَىٰ وَأَقۡنَىٰ ٤٨"},{"s":53,"a":49,"t":"وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعۡرَىٰ ٤٩"},{"s":53,"a":50,"t":"وَأَنَّهُۥٓ أَهۡلَكَ عَادًا ٱلۡأُولَىٰ ٥٠"},{"s":53,"a":51,"t":"وَثَمُودَاْ فَمَآ أَبۡقَىٰ ٥١"},{"s":53,"a":52,"t":"وَقَوۡمَ نُوحٖ مِّن قَبۡلُۖ إِنَّهُمۡ كَانُواْ هُمۡ أَظۡلَمَ وَأَطۡغَىٰ ٥٢"},{"s":53,"a":53,"t":"وَٱلۡمُؤۡتَفِكَةَ أَهۡوَىٰ ٥٣"},{"s":53,"a":54,"t":"فَغَشَّىٰهَا مَا غَشَّىٰ ٥٤"},{"s":53,"a":55,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ ٥٥"},{"s":53,"a":56,"t":"هَٰذَا نَذِيرٞ مِّنَ ٱلنُّذُرِ ٱلۡأُولَىٰٓ ٥٦"},{"s":53,"a":57,"t":"أَزِفَتِ ٱلۡأٓزِفَةُ ٥٧"},{"s":53,"a":58,"t":"لَيۡسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ ٥٨"},{"s":53,"a":59,"t":"أَفَمِنۡ هَٰذَا ٱلۡحَدِيثِ تَعۡجَبُونَ ٥٩"},{"s":53,"a":60,"t":"وَتَضۡحَكُونَ وَلَا تَبۡكُونَ ٦٠"},{"s":53,"a":61,"t":"وَأَنتُمۡ سَٰمِدُونَ ٦١"},{"s":53,"a":62,"t":"فَٱسۡجُدُواْۤ لِلَّهِۤ وَٱعۡبُدُواْ۩ ٦٢"},{"s":54,"a":1,"t":"ٱقۡتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلۡقَمَرُ ١"},{"s":54,"a":2,"t":"وَإِن يَرَوۡاْ ءَايَةٗ يُعۡرِضُواْ وَيَقُولُواْ سِحۡرٞ مُّسۡتَمِرّٞ ٢"},{"s":54,"a":3,"t":"وَكَذَّبُواْ وَٱتَّبَعُوٓاْ أَهۡوَآءَهُمۡۚ وَكُلُّ أَمۡرٖ مُّسۡتَقِرّٞ ٣"},{"s":54,"a":4,"t":"وَلَقَدۡ جَآءَهُم مِّنَ ٱلۡأَنۢبَآءِ مَا فِيهِ مُزۡدَجَرٌ ٤"},{"s":54,"a":5,"t":"حِكۡمَةُۢ بَٰلِغَةٞۖ فَمَا تُغۡنِ ٱلنُّذُرُ ٥"},{"s":54,"a":6,"t":"فَتَوَلَّ عَنۡهُمۡۘ يَوۡمَ يَدۡعُ ٱلدَّاعِ إِلَىٰ شَيۡءٖ نُّكُرٍ ٦"}]}