{"page":531,"juz":27,"ayas":[{"s":54,"a":50,"t":"وَمَآ أَمۡرُنَآ إِلَّا وَٰحِدَةٞ كَلَمۡحِۭ بِٱلۡبَصَرِ ٥٠"},{"s":54,"a":51,"t":"وَلَقَدۡ أَهۡلَكۡنَآ أَشۡيَاعَكُمۡ فَهَلۡ مِن مُّدَّكِرٖ ٥١"},{"s":54,"a":52,"t":"وَكُلُّ شَيۡءٖ فَعَلُوهُ فِي ٱلزُّبُرِ ٥٢"},{"s":54,"a":53,"t":"وَكُلُّ صَغِيرٖ وَكَبِيرٖ مُّسۡتَطَرٌ ٥٣"},{"s":54,"a":54,"t":"إِنَّ ٱلۡمُتَّقِينَ فِي جَنَّٰتٖ وَنَهَرٖ ٥٤"},{"s":54,"a":55,"t":"فِي مَقۡعَدِ صِدۡقٍ عِندَ مَلِيكٖ مُّقۡتَدِرِۭ ٥٥"},{"s":55,"a":1,"t":"ٱلرَّحۡمَٰنُ ١"},{"s":55,"a":2,"t":"عَلَّمَ ٱلۡقُرۡءَانَ ٢"},{"s":55,"a":3,"t":"خَلَقَ ٱلۡإِنسَٰنَ ٣"},{"s":55,"a":4,"t":"عَلَّمَهُ ٱلۡبَيَانَ ٤"},{"s":55,"a":5,"t":"ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ ٥"},{"s":55,"a":6,"t":"وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ ٦"},{"s":55,"a":7,"t":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ ٧"},{"s":55,"a":8,"t":"أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ ٨"},{"s":55,"a":9,"t":"وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ ٩"},{"s":55,"a":10,"t":"وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ ١٠"},{"s":55,"a":11,"t":"فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ ١١"},{"s":55,"a":12,"t":"وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ ١٢"},{"s":55,"a":13,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٣"},{"s":55,"a":14,"t":"خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَٱلۡفَخَّارِ ١٤"},{"s":55,"a":15,"t":"وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجٖ مِّن نَّارٖ ١٥"},{"s":55,"a":16,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٦"},{"s":55,"a":17,"t":"رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ ١٧"},{"s":55,"a":18,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٨"}]}