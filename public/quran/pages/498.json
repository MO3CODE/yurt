{"page":498,"juz":25,"ayas":[{"s":44,"a":40,"t":"إِنَّ يَوۡمَ ٱلۡفَصۡلِ مِيقَٰتُهُمۡ أَجۡمَعِينَ ٤٠"},{"s":44,"a":41,"t":"يَوۡمَ لَا يُغۡنِي مَوۡلًى عَن مَّوۡلٗى شَيۡـٔٗا وَلَا هُمۡ يُنصَرُونَ ٤١"},{"s":44,"a":42,"t":"إِلَّا مَن رَّحِمَ ٱللَّهُۚ إِنَّهُۥ هُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ ٤٢"},{"s":44,"a":43,"t":"إِنَّ شَجَرَتَ ٱلزَّقُّومِ ٤٣"},{"s":44,"a":44,"t":"طَعَامُ ٱلۡأَثِيمِ ٤٤"},{"s":44,"a":45,"t":"كَٱلۡمُهۡلِ يَغۡلِي فِي ٱلۡبُطُونِ ٤٥"},{"s":44,"a":46,"t":"كَغَلۡيِ ٱلۡحَمِيمِ ٤٦"},{"s":44,"a":47,"t":"خُذُوهُ فَٱعۡتِلُوهُ إِلَىٰ سَوَآءِ ٱلۡجَحِيمِ ٤٧"},{"s":44,"a":48,"t":"ثُمَّ صُبُّواْ فَوۡقَ رَأۡسِهِۦ مِنۡ عَذَابِ ٱلۡحَمِيمِ ٤٨"},{"s":44,"a":49,"t":"ذُقۡ إِنَّكَ أَنتَ ٱلۡعَزِيزُ ٱلۡكَرِيمُ ٤٩"},{"s":44,"a":50,"t":"إِنَّ هَٰذَا مَا كُنتُم بِهِۦ تَمۡتَرُونَ ٥٠"},{"s":44,"a":51,"t":"إِنَّ ٱلۡمُتَّقِينَ فِي مَقَامٍ أَمِينٖ ٥١"},{"s":44,"a":52,"t":"فِي جَنَّٰتٖ وَعُيُونٖ ٥٢"},{"s":44,"a":53,"t":"يَلۡبَسُونَ مِن سُندُسٖ وَإِسۡتَبۡرَقٖ مُّتَقَٰبِلِينَ ٥٣"},{"s":44,"a":54,"t":"كَذَٰلِكَ وَزَوَّجۡنَٰهُم بِحُورٍ عِينٖ ٥٤"},{"s":44,"a":55,"t":"يَدۡعُونَ فِيهَا بِكُلِّ فَٰكِهَةٍ ءَامِنِينَ ٥٥"},{"s":44,"a":56,"t":"لَا يَذُوقُونَ فِيهَا ٱلۡمَوۡتَ إِلَّا ٱلۡمَوۡتَةَ ٱلۡأُولَىٰۖ وَوَقَىٰهُمۡ عَذَابَ ٱلۡجَحِيمِ ٥٦"},{"s":44,"a":57,"t":"فَضۡلٗا مِّن رَّبِّكَۚ ذَٰلِكَ هُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ ٥٧"},{"s":44,"a":58,"t":"فَإِنَّمَا يَسَّرۡنَٰهُ بِلِسَانِكَ لَعَلَّهُمۡ يَتَذَكَّرُونَ ٥٨"},{"s":44,"a":59,"t":"فَٱرۡتَقِبۡ إِنَّهُم مُّرۡتَقِبُونَ ٥٩"}]}