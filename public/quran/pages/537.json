{"page":537,"juz":27,"ayas":[{"s":56,"a":77,"t":"إِنَّهُۥ لَقُرۡءَانٞ كَرِيمٞ ٧٧"},{"s":56,"a":78,"t":"فِي كِتَٰبٖ مَّكۡنُونٖ ٧٨"},{"s":56,"a":79,"t":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلۡمُطَهَّرُونَ ٧٩"},{"s":56,"a":80,"t":"تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ ٨٠"},{"s":56,"a":81,"t":"أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُم مُّدۡهِنُونَ ٨١"},{"s":56,"a":82,"t":"وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ ٨٢"},{"s":56,"a":83,"t":"فَلَوۡلَآ إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ ٨٣"},{"s":56,"a":84,"t":"وَأَنتُمۡ حِينَئِذٖ تَنظُرُونَ ٨٤"},{"s":56,"a":85,"t":"وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ ٨٥"},{"s":56,"a":86,"t":"فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ ٨٦"},{"s":56,"a":87,"t":"تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ ٨٧"},{"s":56,"a":88,"t":"فَأَمَّآ إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ ٨٨"},{"s":56,"a":89,"t":"فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ ٨٩"},{"s":56,"a":90,"t":"وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ ٩٠"},{"s":56,"a":91,"t":"فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ ٩١"},{"s":56,"a":92,"t":"وَأَمَّآ إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ ٩٢"},{"s":56,"a":93,"t":"فَنُزُلٞ مِّنۡ حَمِيمٖ ٩٣"},{"s":56,"a":94,"t":"وَتَصۡلِيَةُ جَحِيمٍ ٩٤"},{"s":56,"a":95,"t":"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ ٩٥"},{"s":56,"a":96,"t":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٩٦"},{"s":57,"a":1,"t":"سَبَّحَ لِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ ١"},{"s":57,"a":2,"t":"لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ يُحۡيِۦ وَيُمِيتُۖ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ ٢"},{"s":57,"a":3,"t":"هُوَ ٱلۡأَوَّلُ وَٱلۡأٓخِرُ وَٱلظَّٰهِرُ وَٱلۡبَاطِنُۖ وَهُوَ بِكُلِّ شَيۡءٍ عَلِيمٌ ٣"}]}