{"page":594,"juz":30,"ayas":[{"s":89,"a":23,"t":"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ ٢٣"},{"s":89,"a":24,"t":"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي ٢٤"},{"s":89,"a":25,"t":"فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ ٢٥"},{"s":89,"a":26,"t":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ ٢٦"},{"s":89,"a":27,"t":"يَٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ ٢٧"},{"s":89,"a":28,"t":"ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ ٢٨"},{"s":89,"a":29,"t":"فَٱدۡخُلِي فِي عِبَٰدِي ٢٩"},{"s":89,"a":30,"t":"وَٱدۡخُلِي جَنَّتِي ٣٠"},{"s":90,"a":1,"t":"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ ١"},{"s":90,"a":2,"t":"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ ٢"},{"s":90,"a":3,"t":"وَوَالِدٖ وَمَا وَلَدَ ٣"},{"s":90,"a":4,"t":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ ٤"},{"s":90,"a":5,"t":"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدٞ ٥"},{"s":90,"a":6,"t":"يَقُولُ أَهۡلَكۡتُ مَالٗا لُّبَدًا ٦"},{"s":90,"a":7,"t":"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ ٧"},{"s":90,"a":8,"t":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ ٨"},{"s":90,"a":9,"t":"وَلِسَانٗا وَشَفَتَيۡنِ ٩"},{"s":90,"a":10,"t":"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ ١٠"},{"s":90,"a":11,"t":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ ١١"},{"s":90,"a":12,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ ١٢"},{"s":90,"a":13,"t":"فَكُّ رَقَبَةٍ ١٣"},{"s":90,"a":14,"t":"أَوۡ إِطۡعَٰمٞ فِي يَوۡمٖ ذِي مَسۡغَبَةٖ ١٤"},{"s":90,"a":15,"t":"يَتِيمٗا ذَا مَقۡرَبَةٍ ١٥"},{"s":90,"a":16,"t":"أَوۡ مِسۡكِينٗا ذَا مَتۡرَبَةٖ ١٦"},{"s":90,"a":17,"t":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ ١٧"},{"s":90,"a":18,"t":"أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ ١٨"}]}