{"page":447,"juz":23,"ayas":[{"s":37,"a":25,"t":"مَا لَكُمۡ لَا تَنَاصَرُونَ ٢٥"},{"s":37,"a":26,"t":"بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ ٢٦"},{"s":37,"a":27,"t":"وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ ٢٧"},{"s":37,"a":28,"t":"قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ ٢٨"},{"s":37,"a":29,"t":"قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ ٢٩"},{"s":37,"a":30,"t":"وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمٗا طَٰغِينَ ٣٠"},{"s":37,"a":31,"t":"فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ ٣١"},{"s":37,"a":32,"t":"فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ ٣٢"},{"s":37,"a":33,"t":"فَإِنَّهُمۡ يَوۡمَئِذٖ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ ٣٣"},{"s":37,"a":34,"t":"إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ ٣٤"},{"s":37,"a":35,"t":"إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ ٣٥"},{"s":37,"a":36,"t":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجۡنُونِۭ ٣٦"},{"s":37,"a":37,"t":"بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ ٣٧"},{"s":37,"a":38,"t":"إِنَّكُمۡ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ ٣٨"},{"s":37,"a":39,"t":"وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ ٣٩"},{"s":37,"a":40,"t":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ٤٠"},{"s":37,"a":41,"t":"أُوْلَٰٓئِكَ لَهُمۡ رِزۡقٞ مَّعۡلُومٞ ٤١"},{"s":37,"a":42,"t":"فَوَٰكِهُ وَهُم مُّكۡرَمُونَ ٤٢"},{"s":37,"a":43,"t":"فِي جَنَّٰتِ ٱلنَّعِيمِ ٤٣"},{"s":37,"a":44,"t":"عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ ٤٤"},{"s":37,"a":45,"t":"يُطَافُ عَلَيۡهِم بِكَأۡسٖ مِّن مَّعِينِۭ ٤٥"},{"s":37,"a":46,"t":"بَيۡضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ ٤٦"},{"s":37,"a":47,"t":"لَا فِيهَا غَوۡلٞ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ ٤٧"},{"s":37,"a":48,"t":"وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينٞ ٤٨"},{"s":37,"a":49,"t":"كَأَنَّهُنَّ بَيۡضٞ مَّكۡنُونٞ ٤٩"},{"s":37,"a":50,"t":"فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ ٥٠"},{"s":37,"a":51,"t":"قَالَ قَآئِلٞ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينٞ ٥١"}]}