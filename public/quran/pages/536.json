{"page":536,"juz":27,"ayas":[{"s":56,"a":51,"t":"ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ ٥١"},{"s":56,"a":52,"t":"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ ٥٢"},{"s":56,"a":53,"t":"فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ ٥٣"},{"s":56,"a":54,"t":"فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ ٥٤"},{"s":56,"a":55,"t":"فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ ٥٥"},{"s":56,"a":56,"t":"هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ ٥٦"},{"s":56,"a":57,"t":"نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ ٥٧"},{"s":56,"a":58,"t":"أَفَرَءَيۡتُم مَّا تُمۡنُونَ ٥٨"},{"s":56,"a":59,"t":"ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ ٥٩"},{"s":56,"a":60,"t":"نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ ٦٠"},{"s":56,"a":61,"t":"عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ ٦١"},{"s":56,"a":62,"t":"وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ ٦٢"},{"s":56,"a":63,"t":"أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ ٦٣"},{"s":56,"a":64,"t":"ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّٰرِعُونَ ٦٤"},{"s":56,"a":65,"t":"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ ٦٥"},{"s":56,"a":66,"t":"إِنَّا لَمُغۡرَمُونَ ٦٦"},{"s":56,"a":67,"t":"بَلۡ نَحۡنُ مَحۡرُومُونَ ٦٧"},{"s":56,"a":68,"t":"أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ ٦٨"},{"s":56,"a":69,"t":"ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ ٦٩"},{"s":56,"a":70,"t":"لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ ٧٠"},{"s":56,"a":71,"t":"أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ ٧١"},{"s":56,"a":72,"t":"ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ ٧٢"},{"s":56,"a":73,"t":"نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ ٧٣"},{"s":56,"a":74,"t":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٧٤"},{"s":56,"a":75,"t":"۞ فَلَآ أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ ٧٥"},{"s":56,"a":76,"t":"وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ ٧٦"}]}