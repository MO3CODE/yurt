{"page":593,"juz":30,"ayas":[{"s":88,"a":23,"t":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ ٢٣"},{"s":88,"a":24,"t":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ ٢٤"},{"s":88,"a":25,"t":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ ٢٥"},{"s":88,"a":26,"t":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم ٢٦"},{"s":89,"a":1,"t":"وَٱلۡفَجۡرِ ١"},{"s":89,"a":2,"t":"وَلَيَالٍ عَشۡرٖ ٢"},{"s":89,"a":3,"t":"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ ٣"},{"s":89,"a":4,"t":"وَٱلَّيۡلِ إِذَا يَسۡرِ ٤"},{"s":89,"a":5,"t":"هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ ٥"},{"s":89,"a":6,"t":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ ٦"},{"s":89,"a":7,"t":"إِرَمَ ذَاتِ ٱلۡعِمَادِ ٧"},{"s":89,"a":8,"t":"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ ٨"},{"s":89,"a":9,"t":"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ ٩"},{"s":89,"a":10,"t":"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ ١٠"},{"s":89,"a":11,"t":"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ ١١"},{"s":89,"a":12,"t":"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ ١٢"},{"s":89,"a":13,"t":"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ ١٣"},{"s":89,"a":14,"t":"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ ١٤"},{"s":89,"a":15,"t":"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ ١٥"},{"s":89,"a":16,"t":"وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ ١٦"},{"s":89,"a":17,"t":"كـَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ ١٧"},{"s":89,"a":18,"t":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ١٨"},{"s":89,"a":19,"t":"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا ١٩"},{"s":89,"a":20,"t":"وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا ٢٠"},{"s":89,"a":21,"t":"كـَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا ٢١"},{"s":89,"a":22,"t":"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا ٢٢"}]}