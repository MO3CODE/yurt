{"page":584,"juz":30,"ayas":[{"s":79,"a":17,"t":"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ ١٧"},{"s":79,"a":18,"t":"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ ١٨"},{"s":79,"a":19,"t":"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ ١٩"},{"s":79,"a":20,"t":"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ ٢٠"},{"s":79,"a":21,"t":"فَكَذَّبَ وَعَصَىٰ ٢١"},{"s":79,"a":22,"t":"ثُمَّ أَدۡبَرَ يَسۡعَىٰ ٢٢"},{"s":79,"a":23,"t":"فَحَشَرَ فَنَادَىٰ ٢٣"},{"s":79,"a":24,"t":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ ٢٤"},{"s":79,"a":25,"t":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ ٢٥"},{"s":79,"a":26,"t":"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىٰٓ ٢٦"},{"s":79,"a":27,"t":"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا ٢٧"},{"s":79,"a":28,"t":"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا ٢٨"},{"s":79,"a":29,"t":"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا ٢٩"},{"s":79,"a":30,"t":"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ ٣٠"},{"s":79,"a":31,"t":"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا ٣١"},{"s":79,"a":32,"t":"وَٱلۡجِبَالَ أَرۡسَىٰهَا ٣٢"},{"s":79,"a":33,"t":"مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ ٣٣"},{"s":79,"a":34,"t":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ ٣٤"},{"s":79,"a":35,"t":"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ ٣٥"},{"s":79,"a":36,"t":"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ ٣٦"},{"s":79,"a":37,"t":"فَأَمَّا مَن طَغَىٰ ٣٧"},{"s":79,"a":38,"t":"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا ٣٨"},{"s":79,"a":39,"t":"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ ٣٩"},{"s":79,"a":40,"t":"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ ٤٠"},{"s":79,"a":41,"t":"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ ٤١"},{"s":79,"a":42,"t":"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا ٤٢"},{"s":79,"a":43,"t":"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ ٤٣"},{"s":79,"a":44,"t":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ ٤٤"},{"s":79,"a":45,"t":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا ٤٥"},{"s":79,"a":46,"t":"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا ٤٦"}]}