{"page":569,"juz":29,"ayas":[{"s":70,"a":11,"t":"يُبَصَّرُونَهُمۡۚ يَوَدُّ ٱلۡمُجۡرِمُ لَوۡ يَفۡتَدِي مِنۡ عَذَابِ يَوۡمِئِذِۭ بِبَنِيهِ ١١"},{"s":70,"a":12,"t":"وَصَٰحِبَتِهِۦ وَأَخِيهِ ١٢"},{"s":70,"a":13,"t":"وَفَصِيلَتِهِ ٱلَّتِي تُـٔۡوِيهِ ١٣"},{"s":70,"a":14,"t":"وَمَن فِي ٱلۡأَرۡضِ جَمِيعٗا ثُمَّ يُنجِيهِ ١٤"},{"s":70,"a":15,"t":"كـَلَّآۖ إِنَّهَا لَظَىٰ ١٥"},{"s":70,"a":16,"t":"نَزَّاعَةٗ لِّلشَّوَىٰ ١٦"},{"s":70,"a":17,"t":"تَدۡعُواْ مَنۡ أَدۡبَرَ وَتَوَلَّىٰ ١٧"},{"s":70,"a":18,"t":"وَجَمَعَ فَأَوۡعَىٰٓ ١٨"},{"s":70,"a":19,"t":"۞ إِنَّ ٱلۡإِنسَٰنَ خُلِقَ هَلُوعًا ١٩"},{"s":70,"a":20,"t":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعٗا ٢٠"},{"s":70,"a":21,"t":"وَإِذَا مَسَّهُ ٱلۡخَيۡرُ مَنُوعًا ٢١"},{"s":70,"a":22,"t":"إِلَّا ٱلۡمُصَلِّينَ ٢٢"},{"s":70,"a":23,"t":"ٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ دَآئِمُونَ ٢٣"},{"s":70,"a":24,"t":"وَٱلَّذِينَ فِيٓ أَمۡوَٰلِهِمۡ حَقّٞ مَّعۡلُومٞ ٢٤"},{"s":70,"a":25,"t":"لِّلسَّآئِلِ وَٱلۡمَحۡرُومِ ٢٥"},{"s":70,"a":26,"t":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوۡمِ ٱلدِّينِ ٢٦"},{"s":70,"a":27,"t":"وَٱلَّذِينَ هُم مِّنۡ عَذَابِ رَبِّهِم مُّشۡفِقُونَ ٢٧"},{"s":70,"a":28,"t":"إِنَّ عَذَابَ رَبِّهِمۡ غَيۡرُ مَأۡمُونٖ ٢٨"},{"s":70,"a":29,"t":"وَٱلَّذِينَ هُمۡ لِفُرُوجِهِمۡ حَٰفِظُونَ ٢٩"},{"s":70,"a":30,"t":"إِلَّا عَلَىٰٓ أَزۡوَٰجِهِمۡ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَإِنَّهُمۡ غَيۡرُ مَلُومِينَ ٣٠"},{"s":70,"a":31,"t":"فَمَنِ ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ ٱلۡعَادُونَ ٣١"},{"s":70,"a":32,"t":"وَٱلَّذِينَ هُمۡ لِأَمَٰنَٰتِهِمۡ وَعَهۡدِهِمۡ رَٰعُونَ ٣٢"},{"s":70,"a":33,"t":"وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمۡ قَآئِمُونَ ٣٣"},{"s":70,"a":34,"t":"وَٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ يُحَافِظُونَ ٣٤"},{"s":70,"a":35,"t":"أُوْلَٰٓئِكَ فِي جَنَّٰتٖ مُّكۡرَمُونَ ٣٥"},{"s":70,"a":36,"t":"فَمَالِ ٱلَّذِينَ كَفَرُواْ قِبَلَكَ مُهۡطِعِينَ ٣٦"},{"s":70,"a":37,"t":"عَنِ ٱلۡيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ ٣٧"},{"s":70,"a":38,"t":"أَيَطۡمَعُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُدۡخَلَ جَنَّةَ نَعِيمٖ ٣٨"},{"s":70,"a":39,"t":"كـَلَّآۖ إِنَّا خَلَقۡنَٰهُم مِّمَّا يَعۡلَمُونَ ٣٩"},{"s":70,"a":40,"t":"فَلَآ أُقۡسِمُ بِرَبِّ ٱلۡمَشَٰرِقِ وَٱلۡمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ ٤٠"}]}