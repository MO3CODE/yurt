{"page":601,"juz":30,"ayas":[{"s":103,"a":1,"t":"وَٱلۡعَصۡرِ ١"},{"s":103,"a":2,"t":"إِنَّ ٱلۡإِنسَٰنَ لَفِي خُسۡرٍ ٢"},{"s":103,"a":3,"t":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَتَوَاصَوۡاْ بِٱلۡحَقِّ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ ٣"},{"s":104,"a":1,"t":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ ١"},{"s":104,"a":2,"t":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ ٢"},{"s":104,"a":3,"t":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ ٣"},{"s":104,"a":4,"t":"كـَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ ٤"},{"s":104,"a":5,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ ٥"},{"s":104,"a":6,"t":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ ٦"},{"s":104,"a":7,"t":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ ٧"},{"s":104,"a":8,"t":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ ٨"},{"s":104,"a":9,"t":"فِي عَمَدٖ مُّمَدَّدَةِۭ ٩"},{"s":105,"a":1,"t":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ ١"},{"s":105,"a":2,"t":"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلٖ ٢"},{"s":105,"a":3,"t":"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ ٣"},{"s":105,"a":4,"t":"تَرۡمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ ٤"},{"s":105,"a":5,"t":"فَجَعَلَهُمۡ كَعَصۡفٖ مَّأۡكُولِۭ ٥"}]}