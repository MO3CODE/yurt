{"page":375,"juz":19,"ayas":[{"s":26,"a":184,"t":"وَٱتَّقُواْ ٱلَّذِي خَلَقَكُمۡ وَٱلۡجِبِلَّةَ ٱلۡأَوَّلِينَ ١٨٤"},{"s":26,"a":185,"t":"قَالُوٓاْ إِنَّمَآ أَنتَ مِنَ ٱلۡمُسَحَّرِينَ ١٨٥"},{"s":26,"a":186,"t":"وَمَآ أَنتَ إِلَّا بَشَرٞ مِّثۡلُنَا وَإِن نَّظُنُّكَ لَمِنَ ٱلۡكَٰذِبِينَ ١٨٦"},{"s":26,"a":187,"t":"فَأَسۡقِطۡ عَلَيۡنَا كِسَفٗا مِّنَ ٱلسَّمَآءِ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ ١٨٧"},{"s":26,"a":188,"t":"قَالَ رَبِّيٓ أَعۡلَمُ بِمَا تَعۡمَلُونَ ١٨٨"},{"s":26,"a":189,"t":"فَكَذَّبُوهُ فَأَخَذَهُمۡ عَذَابُ يَوۡمِ ٱلظُّلَّةِۚ إِنَّهُۥ كَانَ عَذَابَ يَوۡمٍ عَظِيمٍ ١٨٩"},{"s":26,"a":190,"t":"إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ ١٩٠"},{"s":26,"a":191,"t":"وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ ١٩١"},{"s":26,"a":192,"t":"وَإِنَّهُۥ لَتَنزِيلُ رَبِّ ٱلۡعَٰلَمِينَ ١٩٢"},{"s":26,"a":193,"t":"نَزَلَ بِهِ ٱلرُّوحُ ٱلۡأَمِينُ ١٩٣"},{"s":26,"a":194,"t":"عَلَىٰ قَلۡبِكَ لِتَكُونَ مِنَ ٱلۡمُنذِرِينَ ١٩٤"},{"s":26,"a":195,"t":"بِلِسَانٍ عَرَبِيّٖ مُّبِينٖ ١٩٥"},{"s":26,"a":196,"t":"وَإِنَّهُۥ لَفِي زُبُرِ ٱلۡأَوَّلِينَ ١٩٦"},{"s":26,"a":197,"t":"أَوَلَمۡ يَكُن لَّهُمۡ ءَايَةً أَن يَعۡلَمَهُۥ عُلَمَٰٓؤُاْ بَنِيٓ إِسۡرَٰٓءِيلَ ١٩٧"},{"s":26,"a":198,"t":"وَلَوۡ نَزَّلۡنَٰهُ عَلَىٰ بَعۡضِ ٱلۡأَعۡجَمِينَ ١٩٨"},{"s":26,"a":199,"t":"فَقَرَأَهُۥ عَلَيۡهِم مَّا كَانُواْ بِهِۦ مُؤۡمِنِينَ ١٩٩"},{"s":26,"a":200,"t":"كَذَٰلِكَ سَلَكۡنَٰهُ فِي قُلُوبِ ٱلۡمُجۡرِمِينَ ٢٠٠"},{"s":26,"a":201,"t":"لَا يُؤۡمِنُونَ بِهِۦ حَتَّىٰ يَرَوُاْ ٱلۡعَذَابَ ٱلۡأَلِيمَ ٢٠١"},{"s":26,"a":202,"t":"فَيَأۡتِيَهُم بَغۡتَةٗ وَهُمۡ لَا يَشۡعُرُونَ ٢٠٢"},{"s":26,"a":203,"t":"فَيَقُولُواْ هَلۡ نَحۡنُ مُنظَرُونَ ٢٠٣"},{"s":26,"a":204,"t":"أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ ٢٠٤"},{"s":26,"a":205,"t":"أَفَرَءَيۡتَ إِن مَّتَّعۡنَٰهُمۡ سِنِينَ ٢٠٥"},{"s":26,"a":206,"t":"ثُمَّ جَآءَهُم مَّا كَانُواْ يُوعَدُونَ ٢٠٦"}]}