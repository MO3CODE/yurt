{"page":596,"juz":30,"ayas":[{"s":92,"a":10,"t":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ ١٠"},{"s":92,"a":11,"t":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ ١١"},{"s":92,"a":12,"t":"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ ١٢"},{"s":92,"a":13,"t":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ ١٣"},{"s":92,"a":14,"t":"فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ ١٤"},{"s":92,"a":15,"t":"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى ١٥"},{"s":92,"a":16,"t":"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ ١٦"},{"s":92,"a":17,"t":"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى ١٧"},{"s":92,"a":18,"t":"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ ١٨"},{"s":92,"a":19,"t":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ ١٩"},{"s":92,"a":20,"t":"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ ٢٠"},{"s":92,"a":21,"t":"وَلَسَوۡفَ يَرۡضَىٰ ٢١"},{"s":93,"a":1,"t":"وَٱلضُّحَىٰ ١"},{"s":93,"a":2,"t":"وَٱلَّيۡلِ إِذَا سَجَىٰ ٢"},{"s":93,"a":3,"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ ٣"},{"s":93,"a":4,"t":"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ ٤"},{"s":93,"a":5,"t":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ ٥"},{"s":93,"a":6,"t":"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ ٦"},{"s":93,"a":7,"t":"وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ ٧"},{"s":93,"a":8,"t":"وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ ٨"},{"s":93,"a":9,"t":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ ٩"},{"s":93,"a":10,"t":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ ١٠"},{"s":93,"a":11,"t":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ ١١"},{"s":94,"a":1,"t":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ ١"},{"s":94,"a":2,"t":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ ٢"}]}