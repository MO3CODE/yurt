{"page":451,"juz":23,"ayas":[{"s":37,"a":127,"t":"فَكَذَّبُوهُ فَإِنَّهُمۡ لَمُحۡضَرُونَ ١٢٧"},{"s":37,"a":128,"t":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ١٢٨"},{"s":37,"a":129,"t":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ ١٢٩"},{"s":37,"a":130,"t":"سَلَٰمٌ عَلَىٰٓ إِلۡ يَاسِينَ ١٣٠"},{"s":37,"a":131,"t":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ١٣١"},{"s":37,"a":132,"t":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ ١٣٢"},{"s":37,"a":133,"t":"وَإِنَّ لُوطٗا لَّمِنَ ٱلۡمُرۡسَلِينَ ١٣٣"},{"s":37,"a":134,"t":"إِذۡ نَجَّيۡنَٰهُ وَأَهۡلَهُۥٓ أَجۡمَعِينَ ١٣٤"},{"s":37,"a":135,"t":"إِلَّا عَجُوزٗا فِي ٱلۡغَٰبِرِينَ ١٣٥"},{"s":37,"a":136,"t":"ثُمَّ دَمَّرۡنَا ٱلۡأٓخَرِينَ ١٣٦"},{"s":37,"a":137,"t":"وَإِنَّكُمۡ لَتَمُرُّونَ عَلَيۡهِم مُّصۡبِحِينَ ١٣٧"},{"s":37,"a":138,"t":"وَبِٱلَّيۡلِۚ أَفَلَا تَعۡقِلُونَ ١٣٨"},{"s":37,"a":139,"t":"وَإِنَّ يُونُسَ لَمِنَ ٱلۡمُرۡسَلِينَ ١٣٩"},{"s":37,"a":140,"t":"إِذۡ أَبَقَ إِلَى ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ ١٤٠"},{"s":37,"a":141,"t":"فَسَاهَمَ فَكَانَ مِنَ ٱلۡمُدۡحَضِينَ ١٤١"},{"s":37,"a":142,"t":"فَٱلۡتَقَمَهُ ٱلۡحُوتُ وَهُوَ مُلِيمٞ ١٤٢"},{"s":37,"a":143,"t":"فَلَوۡلَآ أَنَّهُۥ كَانَ مِنَ ٱلۡمُسَبِّحِينَ ١٤٣"},{"s":37,"a":144,"t":"لَلَبِثَ فِي بَطۡنِهِۦٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ ١٤٤"},{"s":37,"a":145,"t":"۞ فَنَبَذۡنَٰهُ بِٱلۡعَرَآءِ وَهُوَ سَقِيمٞ ١٤٥"},{"s":37,"a":146,"t":"وَأَنۢبَتۡنَا عَلَيۡهِ شَجَرَةٗ مِّن يَقۡطِينٖ ١٤٦"},{"s":37,"a":147,"t":"وَأَرۡسَلۡنَٰهُ إِلَىٰ مِاْئَةِ أَلۡفٍ أَوۡ يَزِيدُونَ ١٤٧"},{"s":37,"a":148,"t":"فَـَٔامَنُواْ فَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينٖ ١٤٨"},{"s":37,"a":149,"t":"فَٱسۡتَفۡتِهِمۡ أَلِرَبِّكَ ٱلۡبَنَاتُ وَلَهُمُ ٱلۡبَنُونَ ١٤٩"},{"s":37,"a":150,"t":"أَمۡ خَلَقۡنَا ٱلۡمَلَٰٓئِكَةَ إِنَٰثٗا وَهُمۡ شَٰهِدُونَ ١٥٠"},{"s":37,"a":151,"t":"أَلَآ إِنَّهُم مِّنۡ إِفۡكِهِمۡ لَيَقُولُونَ ١٥١"},{"s":37,"a":152,"t":"وَلَدَ ٱللَّهُ وَإِنَّهُمۡ لَكَٰذِبُونَ ١٥٢"},{"s":37,"a":153,"t":"أَصۡطَفَى ٱلۡبَنَاتِ عَلَى ٱلۡبَنِينَ ١٥٣"}]}