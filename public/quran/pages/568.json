{"page":568,"juz":29,"ayas":[{"s":69,"a":36,"t":"وَلَا طَعَامٌ إِلَّا مِنۡ غِسۡلِينٖ ٣٦"},{"s":69,"a":37,"t":"لَّا يَأۡكُلُهُۥٓ إِلَّا ٱلۡخَٰطِـُٔونَ ٣٧"},{"s":69,"a":38,"t":"فَلَآ أُقۡسِمُ بِمَا تُبۡصِرُونَ ٣٨"},{"s":69,"a":39,"t":"وَمَا لَا تُبۡصِرُونَ ٣٩"},{"s":69,"a":40,"t":"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ ٤٠"},{"s":69,"a":41,"t":"وَمَا هُوَ بِقَوۡلِ شَاعِرٖۚ قَلِيلٗا مَّا تُؤۡمِنُونَ ٤١"},{"s":69,"a":42,"t":"وَلَا بِقَوۡلِ كَاهِنٖۚ قَلِيلٗا مَّا تَذَكَّرُونَ ٤٢"},{"s":69,"a":43,"t":"تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ ٤٣"},{"s":69,"a":44,"t":"وَلَوۡ تَقَوَّلَ عَلَيۡنَا بَعۡضَ ٱلۡأَقَاوِيلِ ٤٤"},{"s":69,"a":45,"t":"لَأَخَذۡنَا مِنۡهُ بِٱلۡيَمِينِ ٤٥"},{"s":69,"a":46,"t":"ثُمَّ لَقَطَعۡنَا مِنۡهُ ٱلۡوَتِينَ ٤٦"},{"s":69,"a":47,"t":"فَمَا مِنكُم مِّنۡ أَحَدٍ عَنۡهُ حَٰجِزِينَ ٤٧"},{"s":69,"a":48,"t":"وَإِنَّهُۥ لَتَذۡكِرَةٞ لِّلۡمُتَّقِينَ ٤٨"},{"s":69,"a":49,"t":"وَإِنَّا لَنَعۡلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ ٤٩"},{"s":69,"a":50,"t":"وَإِنَّهُۥ لَحَسۡرَةٌ عَلَى ٱلۡكَٰفِرِينَ ٥٠"},{"s":69,"a":51,"t":"وَإِنَّهُۥ لَحَقُّ ٱلۡيَقِينِ ٥١"},{"s":69,"a":52,"t":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٥٢"},{"s":70,"a":1,"t":"سَأَلَ سَآئِلُۢ بِعَذَابٖ وَاقِعٖ ١"},{"s":70,"a":2,"t":"لِّلۡكَٰفِرِينَ لَيۡسَ لَهُۥ دَافِعٞ ٢"},{"s":70,"a":3,"t":"مِّنَ ٱللَّهِ ذِي ٱلۡمَعَارِجِ ٣"},{"s":70,"a":4,"t":"تَعۡرُجُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيۡهِ فِي يَوۡمٖ كَانَ مِقۡدَارُهُۥ خَمۡسِينَ أَلۡفَ سَنَةٖ ٤"},{"s":70,"a":5,"t":"فَٱصۡبِرۡ صَبۡرٗا جَمِيلًا ٥"},{"s":70,"a":6,"t":"إِنَّهُمۡ يَرَوۡنَهُۥ بَعِيدٗا ٦"},{"s":70,"a":7,"t":"وَنَرَىٰهُ قَرِيبٗا ٧"},{"s":70,"a":8,"t":"يَوۡمَ تَكُونُ ٱلسَّمَآءُ كَٱلۡمُهۡلِ ٨"},{"s":70,"a":9,"t":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٩"},{"s":70,"a":10,"t":"وَلَا يَسۡـَٔلُ حَمِيمٌ حَمِيمٗا ١٠"}]}