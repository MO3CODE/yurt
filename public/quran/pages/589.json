{"page":589,"juz":30,"ayas":[{"s":83,"a":34,"t":"فَٱلۡيَوۡمَ ٱلَّذِينَ ءَامَنُواْ مِنَ ٱلۡكُفَّارِ يَضۡحَكُونَ ٣٤"},{"s":83,"a":35,"t":"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ ٣٥"},{"s":83,"a":36,"t":"هَلۡ ثُوِّبَ ٱلۡكُفَّارُ مَا كَانُواْ يَفۡعَلُونَ ٣٦"},{"s":84,"a":1,"t":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ ١"},{"s":84,"a":2,"t":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ ٢"},{"s":84,"a":3,"t":"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ ٣"},{"s":84,"a":4,"t":"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ ٤"},{"s":84,"a":5,"t":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ ٥"},{"s":84,"a":6,"t":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ ٦"},{"s":84,"a":7,"t":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ ٧"},{"s":84,"a":8,"t":"فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا ٨"},{"s":84,"a":9,"t":"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا ٩"},{"s":84,"a":10,"t":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ ١٠"},{"s":84,"a":11,"t":"فَسَوۡفَ يَدۡعُواْ ثُبُورٗا ١١"},{"s":84,"a":12,"t":"وَيَصۡلَىٰ سَعِيرًا ١٢"},{"s":84,"a":13,"t":"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا ١٣"},{"s":84,"a":14,"t":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ ١٤"},{"s":84,"a":15,"t":"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا ١٥"},{"s":84,"a":16,"t":"فَلَآ أُقۡسِمُ بِٱلشَّفَقِ ١٦"},{"s":84,"a":17,"t":"وَٱلَّيۡلِ وَمَا وَسَقَ ١٧"},{"s":84,"a":18,"t":"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ ١٨"},{"s":84,"a":19,"t":"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ ١٩"},{"s":84,"a":20,"t":"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ ٢٠"},{"s":84,"a":21,"t":"وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩ ٢١"},{"s":84,"a":22,"t":"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ ٢٢"},{"s":84,"a":23,"t":"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ ٢٣"},{"s":84,"a":24,"t":"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ ٢٤"}]}