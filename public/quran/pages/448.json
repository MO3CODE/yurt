{"page":448,"juz":23,"ayas":[{"s":37,"a":52,"t":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ ٥٢"},{"s":37,"a":53,"t":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ ٥٣"},{"s":37,"a":54,"t":"قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ ٥٤"},{"s":37,"a":55,"t":"فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ ٱلۡجَحِيمِ ٥٥"},{"s":37,"a":56,"t":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ ٥٦"},{"s":37,"a":57,"t":"وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ ٥٧"},{"s":37,"a":58,"t":"أَفَمَا نَحۡنُ بِمَيِّتِينَ ٥٨"},{"s":37,"a":59,"t":"إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ ٥٩"},{"s":37,"a":60,"t":"إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ ٦٠"},{"s":37,"a":61,"t":"لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ ٦١"},{"s":37,"a":62,"t":"أَذَٰلِكَ خَيۡرٞ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ ٦٢"},{"s":37,"a":63,"t":"إِنَّا جَعَلۡنَٰهَا فِتۡنَةٗ لِّلظَّٰلِمِينَ ٦٣"},{"s":37,"a":64,"t":"إِنَّهَا شَجَرَةٞ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ ٦٤"},{"s":37,"a":65,"t":"طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ ٦٥"},{"s":37,"a":66,"t":"فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ ٦٦"},{"s":37,"a":67,"t":"ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبٗا مِّنۡ حَمِيمٖ ٦٧"},{"s":37,"a":68,"t":"ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ ٦٨"},{"s":37,"a":69,"t":"إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ ٦٩"},{"s":37,"a":70,"t":"فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ ٧٠"},{"s":37,"a":71,"t":"وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ ٧١"},{"s":37,"a":72,"t":"وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ ٧٢"},{"s":37,"a":73,"t":"فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ ٧٣"},{"s":37,"a":74,"t":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ٧٤"},{"s":37,"a":75,"t":"وَلَقَدۡ نَادَىٰنَا نُوحٞ فَلَنِعۡمَ ٱلۡمُجِيبُونَ ٧٥"},{"s":37,"a":76,"t":"وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ ٧٦"}]}