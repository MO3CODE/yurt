{"page":587,"juz":30,"ayas":[{"s":82,"a":1,"t":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ ١"},{"s":82,"a":2,"t":"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ ٢"},{"s":82,"a":3,"t":"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ ٣"},{"s":82,"a":4,"t":"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ ٤"},{"s":82,"a":5,"t":"عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ ٥"},{"s":82,"a":6,"t":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ ٦"},{"s":82,"a":7,"t":"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ ٧"},{"s":82,"a":8,"t":"فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ ٨"},{"s":82,"a":9,"t":"كـَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ ٩"},{"s":82,"a":10,"t":"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ ١٠"},{"s":82,"a":11,"t":"كِرَامٗا كَٰتِبِينَ ١١"},{"s":82,"a":12,"t":"يَعۡلَمُونَ مَا تَفۡعَلُونَ ١٢"},{"s":82,"a":13,"t":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ ١٣"},{"s":82,"a":14,"t":"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ ١٤"},{"s":82,"a":15,"t":"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ ١٥"},{"s":82,"a":16,"t":"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ ١٦"},{"s":82,"a":17,"t":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ ١٧"},{"s":82,"a":18,"t":"ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ ١٨"},{"s":82,"a":19,"t":"يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ ١٩"},{"s":83,"a":1,"t":"وَيۡلٞ لِّلۡمُطَفِّفِينَ ١"},{"s":83,"a":2,"t":"ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ يَسۡتَوۡفُونَ ٢"},{"s":83,"a":3,"t":"وَإِذَا كَالُوهُمۡ أَو وَّزَنُوهُمۡ يُخۡسِرُونَ ٣"},{"s":83,"a":4,"t":"أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبۡعُوثُونَ ٤"}]}